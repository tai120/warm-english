  "article": [
    { "en": "I am an art student and I paint a lot of pictures.", "zh": "我是个学艺术的学生，画了很多画。" },
    { "en": "Many people pretend that they understand modern art.", "zh": "有很多人装成很懂现代艺术的样子。" },
    { "en": "They always tell you what a picture is 'about'.", "zh": "他们总是告诉你一幅画的‘意思’是什么。" },
    { "en": "Of course, many pictures are not 'about' anything.", "zh": "当然，有很多画是什么‘意思’也没有的。" },
    { "en": "They are just pretty patterns.", "zh": "它们就是些好看的图案。" },
    { "en": "I think that young children often appreciate modern pictures better than anyone else.", "zh": "我觉得小孩子们往往比任何人都更能欣赏现代绘画。" },
    { "en": "My sister is only seven, but she always tells me whether my pictures are good or not.", "zh": "我的妹妹只有7岁，但她总能告诉我我的画是好还是坏。" },
    { "en": "'I'm hanging this picture on the wall,' I answered.", "zh": "‘我正把这张画挂到墙上，’我回答说。" },
