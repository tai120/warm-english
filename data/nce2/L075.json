  "article": [
    { "en": "A light passenger plane flew off course and crashed in the mountains some time ago.", "zh": "不久前，一架轻型客机偏离了航线，在山区坠毁。" },
    { "en": "The pilot was killed, but the only passengers, a young woman and her two baby daughters, were unhurt.", "zh": "飞行员遇难了，但仅有的乘客——一位年轻妇女和她的两个女婴——却安然无恙。" },
    { "en": "It was the middle of winter, and snow lay thick on the ground.", "zh": "当时正值隆冬，地上覆盖着厚厚的积雪。" },
    { "en": "The woman knew that the nearest village was miles away.", "zh": "这位妇女知道最近的村庄离这里有好几英里远。" },
    { "en": "When it grew dark, she turned a suitcase into a bed and put the children inside it.", "zh": "天黑时，她把一只行李箱改成床，把孩子们放了进去。" },
    { "en": "During the night, it got terribly cold, so she kept as near as she could to the children.", "zh": "夜里天冷得可怕，所以她尽量靠近孩子们。" },
    { "en": "Early next morning, she heard planes passing overhead and wondered how she could send a signal.", "zh": "第二天一早，她听见飞机从头顶飞过，想着怎样才能发出求救信号。" },
    { "en": "She stamped out the letters SOS in the snow.", "zh": "她在雪地上踩出了'SOS'三个字母。" },
    { "en": "Fortunately, a pilot saw the signal and sent a message by radio to the nearest town.", "zh": "幸运的是，一名飞行员看到了信号，用无线电向最近的城镇发了消息。" },
    { "en": "It was not long before a helicopter arrived to rescue the survivors.", "zh": "不久，一架直升飞机赶到了现场，营救失事飞机的幸存者。" }
