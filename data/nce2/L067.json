  "article": [
    { "en": "Haroun Tazieff, a Polish scientist, spent his life studying active volcanoes.", "zh": "哈罗恩·塔捷耶夫是一位波兰科学家，他毕生都在研究活火山。" },
    { "en": "In 1948, he went to Lake Kivu in the Congo to observe a new volcano called Kituro.", "zh": "1948年，他前往刚果的基伍湖，观察一座名叫基图罗的新火山。" },
    { "en": "Tazieff set up his camp at the foot of the volcano.", "zh": "塔捷耶夫在火山脚下搭起了帐篷。" },
    { "en": "He climbed the volcano day after day and took many photographs.", "zh": "他日复一日地攀登火山，拍了许多照片。" },
    { "en": "One day, he noticed that a stream of liquid rock was moving towards him.", "zh": "有一天，他注意到一股岩浆正朝他流过来。" },
    { "en": "The stream threatened to surround him, but Tazieff escaped just in time.", "zh": "岩浆眼看要把他包围，但塔捷耶夫及时逃脱了。" },
    { "en": "He waited until the volcano became quiet, and then he climbed into the crater.", "zh": "他一直等到火山平静下来，然后爬进了火山口。" },
