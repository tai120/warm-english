  "article": [
    { "en": "It must have been about two in the morning when I returned home.", "zh": "我回到家时一定是凌晨两点左右。" },
    { "en": "I tried to wake up my wife by ringing the doorbell, but she was fast asleep.", "zh": "我按门铃想叫醒妻子，但她睡得很熟。" },
    { "en": "So I got a ladder from the shed in the garden.", "zh": "于是我从花园的棚子里搬来一架梯子。" },
    { "en": "I put it against the wall and began climbing towards the bedroom window.", "zh": "我把梯子靠在墙上，开始朝卧室的窗户爬去。" },
    { "en": "I was almost there when a sarcastic voice below said, 'I don't think the windows need cleaning at this time of the night.'", "zh": "快爬到窗口时，下面一个讽刺的声音说：“我看夜里这个时候不需要擦窗户吧。”" },
    { "en": "I looked down and nearly fell off the ladder when I saw a policeman.", "zh": "我朝下一看，看见一名警察，差点从梯子上摔下来。" },
    { "en": "I immediately regretted answering in the way I did, but I said, 'I enjoy cleaning windows at night.'", "zh": "我立刻后悔自己那样回答，可我还是说：“我喜欢在夜里擦窗户。”" },
    { "en": "'Excuse my interrupting you,' the policeman said in the same tone.", "zh": "“请原谅我打断了你，”警察用同样的语气说。" },
    { "en": "I told him I would prefer to stay there, because I had forgotten my key.", "zh": "我告诉他我宁愿待在这里，因为我忘了带钥匙。" },
    { "en": "He asked me what I had said, and I shouted, 'My key!'", "zh": "他问我刚才说了什么，我大声喊道：“我的钥匙！”" }
