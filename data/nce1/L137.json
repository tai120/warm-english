  "article": [
    { "en": "Are you doing the football pools, Brian?", "zh": "布赖恩，你在下足球赛赌注吗？" },
    { "en": "Yes, I've nearly finished, Julie.", "zh": "是的，我快做完了，朱莉。" },
    { "en": "I'm sure we'll win something this week.", "zh": "我相信这个星期我们会赢点什么的。" },
